{
  "name": "vorldx-attendance-system",
  "version": "1.0.0",
  "description": "VorldX Industries Employee Attendance System — MERN Stack Internship Project",
  "private": true,
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:clinet": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "start:server": "cd server && npm start",
    "seed": "cd server && npm run seed",
    "seed:reset": "cd server && npm run seed:reset",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test"
  },
  "keywords": ["attendance", "mern", "vorldx", "internship"],
