# ==============================================================================
# VorldX Employee Attendance System - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vorldx-attendance

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# CORS
CLIENT_URL=http://localhost:5173

# Configured Super Admin sign-in (bcrypt hash only; never put the plaintext password here)
SUPERADMIN_EMAIL=vorldxteam@gmail.com
SUPERADMIN_PASSWORD_HASH=

# Email delivery for OTPs and administrator invitations (Brevo)
BREVO_API_KEY=
SMTP_USER=
EMAIL_FROM=VorldX Attendance <vorldxdesign@gmail.com>

# QR Token
QR_TOKEN_EXPIRES_SECONDS=30
QR_REFRESH_INTERVAL_SECONDS=30

# Demo Mode
DEMO_MODE=true
